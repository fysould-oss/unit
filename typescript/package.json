{
  "name": "calculadora-typescript",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test:jest": "jest --coverage",
    "test:mocha": "mocha --require ts-node/register --extension ts --reporter spec \"tests/mocha/**/*.spec.ts\"",
    "test:jasmine": "tsc -p tsconfig.jasmine.json && jasmine \"dist-jasmine/tests/jasmine/**/*.spec.js\"",
    "build:ui": "tsc -p tsconfig.ui.json",
    "start": "npm run build:ui && node server.cjs",
    "test": "npm run test:jest && npm run test:mocha && npm run test:jasmine"
  },
  "devDependencies": {
    "@types/chai": "^5.0.1",
    "@types/jasmine": "^5.1.5",
    "@types/jest": "^29.5.14",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.2",
    "chai": "^5.1.2",
    "jasmine": "^5.4.0",
    "jest": "^29.7.0",
    "mocha": "^12.0.3",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/tests/jest/**/*.test.ts"
    ],
    "collectCoverageFrom": [
      "src/calculator.ts"
    ]
  }
}
