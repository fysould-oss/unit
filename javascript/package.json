{
  "name": "calculadora-javascript",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test:jest": "jest --coverage",
    "test:mocha": "mocha --reporter spec",
    "test:jasmine": "jasmine \"tests/jasmine/**/*.spec.js\"",
    "start": "node server.cjs",
    "test": "npm run test:jest && npm run test:mocha && npm run test:jasmine"
  },
  "devDependencies": {
    "chai": "^5.1.2",
    "jasmine": "^5.4.0",
    "jest": "^29.7.0",
    "mocha": "^12.0.3"
  },
  "jest": {
    "testMatch": [
      "<rootDir>/tests/jest/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js"
    ]
  },
  "mocha": {
    "spec": "tests/mocha/**/*.spec.js"
  }
}
